# Cube Returns Manager Environment Configuration Template
# Copy this file to .env and configure your API key

# OpenRouter API Key (Recommended for google/gemini-2.5-flash)
OPENROUTER_API_KEY=your_openrouter_api_key_here
VISION_PROVIDER=openrouter
VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_MODEL=google/gemini-2.5-flash

# Alternatively, Google GenAI API Key for direct Gemini SDK access
# GEMINI_API_KEY=your_gemini_api_key_here
